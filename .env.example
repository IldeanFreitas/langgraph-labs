# Copie para .env e preencha. O .env NAO vai para o git.

# --- Modelo ---------------------------------------------------------------
# Chave do Google AI Studio (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Formato "provider:modelo" aceito por init_chat_model / create_agent
LAB_MODEL=google_genai:gemini-3.8-flash

# --- Persistencia (lab 3+) ------------------------------------------------
POSTGRES_URI=postgresql://langgraph:langgraph@localhost:5432/langgraph

# Restringe a desserializacao do checkpoint a tipos conhecidos (recomendado pela doc)
LANGGRAPH_STRICT_MSGPACK=true

# --- Observabilidade (opcional, plano Developer e gratuito) ---------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-labs
